{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/llm.ts": { "maxDuration": 300 },
    "api/extract.ts": { "maxDuration": 60 },
    "api/image.ts": { "maxDuration": 120 },
    "api/admin.ts": { "maxDuration": 180 }
  },
  "rewrites": [
    { "source": "/api/files/:key*", "destination": "/api/files?key=:key*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
