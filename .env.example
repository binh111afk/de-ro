# Sao chép file này thành `.env` rồi điền key.
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# Nếu model chính lỗi/timeout/rỗng, proxy tự chuyển sang model dự bị này.
# LLM_FALLBACK_MODEL=   # model opencode thứ hai (tuỳ chọn; bản -free đã ngừng)
# Dự phòng khi opencode lỗi: Mercury (inceptionlabs.ai)
MERCURY_API_KEY=
# MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-3
# Fallback cuối qua Xkiro nếu OpenCode vẫn không phản hồi.
# XKIRO_API_KEY=   # để trống sẽ đọc provider Xkiro từ ~/.zcode/v2/provider_config.json
# XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=google/gemini-3.8-flash
# Nếu Gemini 3.8 hết quota upstream, proxy tự thử google/gemini-3-flash.

# Thời gian chờ tối đa mỗi lượt gọi model (ms). Dàn ý slide dài có thể cần
# 60–90s với model reasoning; mặc định 120000.
# LLM_TIMEOUT_MS=120000

# Tìm kiếm web (tùy chọn — ưu tiên 3 khi soạn đề).
# Để trống thì app bỏ qua bước search; tệp mẫu và tài liệu đã lưu vẫn dùng bình thường.
TAVILY_API_KEY=
# SEARCH_API_KEY=   # bí danh của TAVILY_API_KEY nếu muốn dùng tên chung

# Tạo ảnh minh hoạ slide (tùy chọn). Bỏ trống thì server đọc provider Xkiro
# trong config ZCode của máy (~/.zcode/v2/provider_config.json).
# IMAGE_BASE_URL=https://api.xkiro.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=openai/gpt-image-2.5
# Dự phòng CUỐI: Claude (Anthropic API chính thức, console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Dự phòng 3 (sau Mercury, xkiro; trước Claude): NightRouter, chuẩn OpenAI.
# Đã so sánh (scripts/compare-llm.ts): deepseek-v4-flash-0731 giá 10đ/lượt, bản trả phí không giới hạn lượt.
NIGHTROUTER_MODEL=deepseek-v4-flash-0731

# --- So sánh model ứng viên: `npm run compare:llm` ---
# FOSTA (chuẩn OpenAI chat/completions)
FOSTA_API_KEY=
FOSTA_BASE_URL=https://codex.fosta.app/v1
FOSTA_MODEL=gpt-6-luna
FOSTA_MODELS=gpt-6.1-sol,gpt-6-astra,gpt-6-luna
# NightRouter: NIGHTROUTER_API_KEY / NIGHTROUTER_BASE_URL dùng chung cho proxy và script; NIGHTROUTER_MODELS chỉ cho script (trống thì tự lấy /models)
NIGHTROUTER_API_KEY=
NIGHTROUTER_BASE_URL=https://api.nightrouter.ai/v1
NIGHTROUTER_MODELS=
