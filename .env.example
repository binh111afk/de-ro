# Sao chép file này thành `.env` rồi điền key.
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# Nếu model chính lỗi/timeout/rỗng, proxy tự chuyển sang model dự bị này.
# LLM_FALLBACK_MODEL=   # model opencode thứ hai (tuỳ chọn; bản -free đã ngừng)
# Dự phòng khi opencode lỗi: DeepSeek chính hãng (platform.deepseek.com) — hiện chỉ đặt ở máy dev
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Dự phòng sau FOSTA: AnyRouter (chuẩn OpenAI, proxy gọi kiểu stream).
# ANYROUTER_API_KEY=
# ANYROUTER_BASE_URL=https://anyrouter.dev/v1
ANYROUTER_MODEL=openai/gpt-6.1-terra

# Thời gian chờ tối đa mỗi lượt gọi model (ms). Dàn ý slide dài có thể cần
# 60–90s với model reasoning; mặc định 120000.
# LLM_TIMEOUT_MS=120000


# Tạo ảnh minh hoạ slide (tùy chọn). Bỏ trống thì server đọc provider Xkiro
# trong config ZCode của máy (~/.zcode/v2/provider_config.json).
# IMAGE_BASE_URL=https://api.xkiro.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=openai/gpt-image-2.5
# Dự phòng CUỐI: Claude (Anthropic API chính thức, console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Dự phòng 3 (sau AnyRouter; trước Claude): NightRouter, chuẩn OpenAI.
# Đã so sánh (scripts/compare-llm.ts): deepseek-v4-flash-0731 giá 10đ/lượt, bản trả phí không giới hạn lượt.
NIGHTROUTER_MODEL=deepseek-v4-flash-0731

# --- So sánh model ứng viên: `npm run compare:llm` ---
# FOSTA (chuẩn OpenAI chat/completions)
FOSTA_API_KEY=
FOSTA_BASE_URL=https://codex.fosta.app/v1
FOSTA_MODEL=gpt-6-luna
FOSTA_MODELS=gpt-6.1-sol,gpt-6-astra,gpt-6-luna
# NightRouter: NIGHTROUTER_API_KEY / NIGHTROUTER_BASE_URL dùng chung cho proxy và script; NIGHTROUTER_MODELS chỉ cho script (trống thì tự lấy /models)
NIGHTROUTER_API_KEY=
NIGHTROUTER_BASE_URL=https://api.nightrouter.ai/v1
NIGHTROUTER_MODELS=

# Khoá mã hoá API key lưu từ trang admin (tối thiểu 32 ký tự). Đổi khoá thì các key đã lưu không dùng được nữa.
AI_SETTINGS_SECRET=
# Tên miền được phép làm endpoint riêng trong trang admin, cách nhau dấu phẩy. Để trống = chỉ dùng endpoint mặc định.
AI_ENDPOINT_ALLOWED_HOSTS=

# Nạp điểm qua PayOS (my.payos.vn → Kênh thanh toán). Thiếu một trong ba thì nút Thanh toán báo "chưa mở".
# Webhook đặt trên PayOS: https://<tên miền>/api/pay?webhook=1  — xem docs/payos.md
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Cloudflare Turnstile (CAPTCHA đăng ký / đăng nhập); bỏ trống thì không hiện, và Supabase phải để tắt CAPTCHA
VITE_TURNSTILE_SITE_KEY=

# Token bí mật phía server cho Muse; để trống để tắt API thống kê.
MUSE_STATS_TOKEN=
# Email, UUID hoặc phần trước @ của email theo dõi, ngăn bằng dấu phẩy.
# Thêm * để trả tối đa 200 tài khoản gần đây cùng tổng số tài khoản. -1 điểm nghĩa là không giới hạn.
MUSE_WATCHLIST=
